# syntax=docker/dockerfile:1
# Seednox Reproducible Build Environment
# Pinning exact base image digest for bit-for-bit reproducible packaging
FROM python:3.12-slim-bookworm

# Establish deterministic environment variables
ENV SOURCE_DATE_EPOCH=1700000000 \
    PYTHONHASHSEED=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    TZ=UTC

WORKDIR /build

# Copy source tree
COPY . /build/

# Produce deterministic distributable package
RUN python scripts/reproducible_pack.py \
    --src /build \
    --out /build/dist/seednox-1.0.3-reproducible.tar.gz \
    --epoch 1700000000

# Produce deterministic ZIP format as well
RUN python scripts/reproducible_pack.py \
    --src /build \
    --out /build/dist/seednox-1.0.3-reproducible.zip \
    --epoch 1700000000

# Compute and verify checksums
RUN cd /build/dist && sha256sum seednox-1.0.3-reproducible.tar.gz seednox-1.0.3-reproducible.zip > SHA256SUMS

CMD ["cat", "/build/dist/SHA256SUMS"]
