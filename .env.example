# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Путь к базе данных (относительно корня проекта, только зашифрованные данные)
# Локально: ./data/seednox.db  |  Docker: /app/data/seednox.db (маппится в ./data/)
DATABASE_PATH=./data/seednox.db

# SQLCipher: шифрование файла БД (Linux/Docker + pip install sqlcipher3)
# DB_ENCRYPTION_KEY=your_long_random_key_here

# Таймаут сессии в секундах (после — требуется повторный ввод пароля)
SESSION_TIMEOUT=900

# Максимум попыток ввода пароля до блокировки
MAX_PASSWORD_ATTEMPTS=5

# Длительность блокировки в секундах
LOCKOUT_DURATION=900

# Argon2id параметры (не менять без миграции!)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
